# ==============================================================================
# CivicSense AI - Enterprise Backend & Integration Environment Configuration
# Phase 11: Secure Multi-Tenant Architecture (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Do NOT commit real secret values to version control.
# - Do NOT expose server-side backend secrets through VITE_* variables.
# - All ERP, OIDC, and database credentials must remain strictly server-side.
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (Optional / If external persistence is configured)
DATABASE_URL=

# Authentication Configuration (OIDC / SSO)
# Supported modes: SANDBOX | OIDC
AUTH_MODE=SANDBOX
JWT_SECRET=<SERVER_SIDE_SIGNING_SECRET>
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=<SERVER_SIDE_SECRET>

# Municipal ERP Integration Configuration
# Supported modes: SANDBOX | ERP
MUNICIPAL_INTEGRATION_MODE=SANDBOX
ERP_BASE_URL=
ERP_CLIENT_ID=
ERP_CLIENT_SECRET=<SERVER_SIDE_SECRET>
ERP_TIMEOUT_MS=5000
ERP_MAX_RETRIES=3

# Security & Network Controls
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX=15

# Satellite Service Client Configuration (Public/Sandbox placeholders)
VITE_SENTINEL_HUB_CLIENT_ID=
VITE_COPERNICUS_API_KEY=
VITE_SATELLITE_API_URL=https://sh.dataspace.copernicus.eu/api/v1/process
